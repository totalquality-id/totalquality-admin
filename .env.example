# Salin menjadi .env untuk development lokal.
# Di Vercel, isi nilai yang sama lewat Project Settings > Environment Variables.
#
# PENTING: semua variabel VITE_* ikut ter-bundle ke dalam JavaScript yang
# dikirim ke browser. JANGAN PERNAH menaruh secret, API key, token, atau
# credential database di sini. Panel ini hanya boleh memegang URL publik.
# Otorisasi sepenuhnya memakai JWT yang didapat setelah login admin.

# Base URL API website Total Quality, lengkap dengan /api di akhir.
# Produksi:
VITE_API_URL="https://totalquality.co.id/api"
# Development lokal (Next.js jalan di port 3000):
# VITE_API_URL="http://localhost:3000/api"

VITE_APP_NAME="Total Quality Admin"
VITE_APP_VERSION="1.0.0"
